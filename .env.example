# ---------------------------------------------------------------------------
# GLINT environment configuration
#
# Copy this file to `.env` (install.ps1 does that for you) and change only what
# you need. Every value below is the default that Glint uses when the variable
# is missing, so an empty .env is perfectly fine.
#
# Nothing in here is a secret: Glint has no API keys and no cloud service.
# ---------------------------------------------------------------------------

# --- Backend server --------------------------------------------------------
# Bound to localhost on purpose. Do not expose Glint publicly.
GLINT_BACKEND_HOST=127.0.0.1
GLINT_BACKEND_PORT=8000

# Origins allowed to call the API directly (CORS). The Vite dev server proxies
# /api, so in normal use CORS is not even involved; keep this list narrow.
GLINT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Document limits (the conservative defaults for an 8 GB PC) ------------
GLINT_MAX_FILE_SIZE_MB=10
GLINT_MAX_PDF_PAGES=10
GLINT_MAX_IMAGE_SIDE_PX=3000
GLINT_PDF_RENDER_DPI=150

# --- Storage ---------------------------------------------------------------
# Relative to the backend folder. The database file lives here.
GLINT_DATA_DIR=backend/data
GLINT_DB_FILENAME=glint.db
GLINT_HISTORY_PAGE_SIZE=50

# --- Local OCR engine ------------------------------------------------------
# "small" is the model that ships inside the rapidocr wheel, so it needs no
# download and works offline. "tiny" and "medium" exist in RapidOCR but are
# downloaded on first use - only switch if you know why.
GLINT_OCR_MODEL_TYPE=small
GLINT_OCR_LANG=ch
GLINT_OCR_USE_CLS=1
GLINT_OCR_WARMUP=1
# 0 = let ONNX Runtime decide how many threads to use. Set 2 on a weak CPU.
GLINT_OCR_THREADS=0
GLINT_OCR_MAX_SIDE_LEN=2000

# --- Frontend --------------------------------------------------------------
# Read by vite.config.ts (not exposed to the browser).
# Browser-facing settings (e.g. VITE_API_BASE_URL) live in frontend/.env -
# see frontend/.env.example.
GLINT_BACKEND_URL=http://127.0.0.1:8000
GLINT_FRONTEND_HOST=127.0.0.1
GLINT_FRONTEND_PORT=5173
# Extra host names the dev server should answer for (comma separated, or *).
GLINT_FRONTEND_ALLOWED_HOSTS=

# Set to 0 if you do not want the backend to serve frontend/dist when present.
GLINT_SERVE_FRONTEND=1
