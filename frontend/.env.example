# ---------------------------------------------------------------------------
# GLINT frontend environment (copy to .env and adjust only if you need to)
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend.
#
# Leave it EMPTY (the default). The browser then calls relative "/api/..." URLs
# and the Vite dev server proxies them to http://127.0.0.1:8000, which avoids
# CORS problems entirely - including when the page is opened through a tunnel.
VITE_API_BASE_URL=

# Only set this when the frontend is served from somewhere that cannot use the
# Vite proxy, for example a statically hosted build:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Dev server settings (read by vite.config.ts, they are NOT exposed to the app)
# ---------------------------------------------------------------------------

# Where the FastAPI backend listens; used as the proxy target.
GLINT_BACKEND_URL=http://127.0.0.1:8000

# The dev server binds to localhost only by default. Use 0.0.0.0 to make it
# reachable from another machine on your network.
GLINT_FRONTEND_HOST=127.0.0.1
GLINT_FRONTEND_PORT=5173

# Extra host names the dev server should answer for (comma separated, or * for
# any). Only needed behind a tunnel or reverse proxy.
GLINT_FRONTEND_ALLOWED_HOSTS=
